{
  "problem": {
    "name": "NSGA-II Engineering Test - Complex Constrained Problem",
    "description": "Complex engineering optimization problem designed for NSGA-II's constraint handling. Features mixed variable constraints and non-linear objective landscape.",
    "type": "Engineering Optimization",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": 0.1,
        "upper_bound": 2.0,
        "initial_value": 0.5
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": 0.1,
        "upper_bound": 10.0,
        "initial_value": 2.0
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": 0.1,
        "upper_bound": 10.0,
        "initial_value": 2.0
      },
      {
        "name": "x4",
        "type": "Real",
        "lower_bound": 1.0,
        "upper_bound": 5.0,
        "initial_value": 3.0
      }
    ],
    "objectives": [
      {
        "name": "weight_minimization",
        "direction": "Minimize",
        "weight": 0.6,
        "function": "x1 * x2 * x3 * x4 * 7.85"
      },
      {
        "name": "stress_factor",
        "direction": "Minimize",
        "weight": 0.4,
        "function": "1000 * x4 / (x1 * x2**2 / 6 + 0.001) + 0.1 * x3"
      }
    ],
    "constraints": [
      {
        "name": "c1_aspect_ratio",
        "type": "Inequality",
        "function": "x2 / x3 - 5.0",
        "operator": "<="
      },
      {
        "name": "c2_minimum_section",
        "type": "Inequality",
        "function": "0.05 - x1 * x2",
        "operator": "<="
      },
      {
        "name": "c3_material_compatibility",
        "type": "Inequality",
        "function": "x1 + x2 - x4 * 2",
        "operator": "<="
      }
    ]
  },
  "algorithm": {
    "category": "Pareto-based",
    "name": "NSGA-II",
    "parameters": {
      "population_size": 100,
      "n_generations": 500,
      "seed": 654
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 15.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 50000,
      "convergence_tolerance": 1e-5,
      "enable_convergence": true,
      "verbose": true
    }
  },
