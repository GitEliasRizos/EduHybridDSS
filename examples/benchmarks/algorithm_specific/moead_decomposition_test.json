{
  "problem": {
    "name": "MOEA/D Decomposition Test - 3-Objective Problem",
    "description": "Well-structured 3-objective problem designed to test MOEA/D's decomposition approach. Uses weight vectors to guide search across different regions of Pareto front. Tests uniform weight distribution.",
    "type": "Decomposition Test Problem",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.33
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.33
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.33
      },
      {
        "name": "x4",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.33
      },
      {
        "name": "x5",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.33
      }
    ],
    "objectives": [
      {
        "name": "f1_sphere",
        "direction": "Minimize",
        "weight": 0.333,
        "function": "x1^2 + sum((x2 + x3 + x4 + x5) / 4)"
      },
      {
        "name": "f2_rosenbrock",
        "direction": "Minimize",
        "weight": 0.333,
        "function": "(1 - x1)^2 + 100 * (x2 - x1^2)^2 + sum((xi - 0.5)^2 for xi in [x3, x4, x5])"
      },
      {
        "name": "f3_rastrigin",
        "direction": "Minimize",
        "weight": 0.334,
        "function": "10 * 5 + sum(xi^2 - 10 * cos(2 * pi * xi) for xi in [x1, x2, x3, x4, x5])"
      }
    ],
    "constraints": [
      {
        "name": "c1_sum_constraint",
        "type": "Equality",
        "function": "x1 + x2 + x3 + x4 + x5 - 2.5",
        "operator": "==",
        "tolerance": 0.01
      }
    ]
  },
  "algorithm": {
    "category": "Decomposition-based",
    "name": "MOEA/D",
    "parameters": {
      "population_size": 105,
      "n_neighbors": 20,
      "prob_neighbor_mating": 0.9,
      "n_generations": 400,
      "seed": 456,
      "decomposition": "PBI",
      "weight_generation": "uniform"
    },
    "crossover": {
      "operator": "DE (Differential Evolution)",
      "probability": 1.0,
      "CR": 0.5,
      "F": 0.5
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.2,
      "eta": 15.0
    },
    "termination": {
      "max_evaluations": 42000,
      "convergence_tolerance": 1e-4,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "MOEA/D decomposition approach test with 3-objective problem"
  }
}
