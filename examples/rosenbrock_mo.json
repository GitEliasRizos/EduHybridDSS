{
  "name": "Rosenbrock Multi-objective",
  "description": "A bi-objective version of the famous Rosenbrock function, which has a challenging narrow valley leading to the global optimum.",
  "type": "Mathematical Function",
  "variables": [
    {"name": "x1", "type": "Real", "lower_bound": -2.0, "upper_bound": 2.0, "initial_value": 0.0},
    {"name": "x2", "type": "Real", "lower_bound": -2.0, "upper_bound": 2.0, "initial_value": 0.0}
  ],
  "objectives": [
    {
      "name": "rosenbrock",
      "direction": "Minimize",
      "weight": 1.0,
      "function": "100 * (x2 - x1**2)**2 + (1 - x1)**2"
    },
    {
      "name": "distance_from_origin",
      "direction": "Minimize",
      "weight": 1.0,
      "function": "x1**2 + x2**2"
    }
  ],
  "constraints": []
}
