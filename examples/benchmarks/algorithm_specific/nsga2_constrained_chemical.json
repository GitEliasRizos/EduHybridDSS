{
  "problem": {
    "name": "NSGA-II Constrained Chemical Process",
    "description": "Constrained chemical process optimization designed for NSGA-II's constraint handling approach. Tests non-dominated sorting with constraint violations in chemical reactor design.",
    "type": "Constrained Chemical Engineering",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": 300.0,
        "upper_bound": 800.0,
        "initial_value": 500.0
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": 1.0,
        "upper_bound": 10.0,
        "initial_value": 5.0
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": 0.1,
        "upper_bound": 5.0,
        "initial_value": 1.0
      },
      {
        "name": "x4",
        "type": "Real",
        "lower_bound": 0.01,
        "upper_bound": 0.5,
        "initial_value": 0.1
      }
    ],
    "objectives": [
      {
        "name": "conversion_efficiency",
        "direction": "Maximize",
        "weight": 0.4,
        "function": "100 * (1 - exp(-x4 * x1 / 500)) * x2 / (1 + x3)"
      },
      {
        "name": "energy_consumption",
        "direction": "Minimize",
        "weight": 0.3,
        "function": "0.001 * x1**2 + 0.1 * x2**2 + 10 * x3**2"
      },
      {
        "name": "operating_cost",
        "direction": "Minimize",
        "weight": 0.3,
        "function": "x1 * 0.1 + x2 * 5 + x4 * 1000 + x3 * 50"
      }
    ],
    "constraints": [
      {
        "name": "c1_temperature_pressure",
        "type": "Inequality",
        "function": "x1 + 100 * x2 - 1500",
        "operator": "<="
      },
      {
        "name": "c2_catalyst_efficiency",
        "type": "Inequality",
        "function": "0.02 - x4 * x2 / x1",
        "operator": "<="
      }
    ]
  },
  "algorithm": {
    "category": "Pareto-based",
    "name": "NSGA-II",
    "parameters": {
      "population_size": 100,
      "n_generations": 500,
      "seed": 258
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 20.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 50000,
      "convergence_tolerance": 1e-4,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "NSGA-II constrained chemical process optimization benchmark"
  }
}
