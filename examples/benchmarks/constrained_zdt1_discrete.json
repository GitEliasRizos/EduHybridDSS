{
  "problem": {
    "name": "Constrained ZDT1 - Discrete Solutions",
    "description": "Modified ZDT1 with constraints to create discrete Pareto front. Tests constrained optimization with reduced solution set. Expected: 5-15 solutions only.",
    "type": "Test Function",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      }
    ],
    "objectives": [
      {
        "name": "f1",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "x1"
      },
      {
        "name": "f2",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "1 + x2 + x3 - x1"
      }
    ],
    "constraints": [
      {
        "name": "sum_constraint", 
        "type": "<=",
        "function": "x1 + x2 + 2*x3",
        "value": 1.3
      }
    ]
  },
  "algorithm": {
    "category": "Pareto-based",
    "name": "NSGA-II",
    "parameters": {
      "population_size": 50,
      "n_generations": 200,
      "seed": 42
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 15.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 30000,
      "convergence_tolerance": 1e-6,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "Constrained ZDT1 benchmark - discrete Pareto front test"
  }
}
