{
  "problem": {
    "name": "NSGA-II Archive Test - ZDT6 Style",
    "description": "ZDT6-based problem optimized for NSGA-II: Non-uniform search space with sparse Pareto optimal region. Tests NSGA-II's non-dominated sorting and crowding distance. Expected: Good performance in difficult regions.",
    "type": "Custom Problem",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      }
    ],
    "objectives": [
      {
        "name": "f1_nonuniform",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "1 - exp(-4 * x1) * sin(6 * pi * x1)**6"
      },
      {
        "name": "f2_sparse",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "(1 + x2 + x3) * (1 - (1 - exp(-4 * x1) * sin(6 * pi * x1)**6) / (1 + x2 + x3))**2"
      }
    ],
    "constraints": []
  },
  "algorithm": {
    "category": "Pareto-based",
    "name": "NSGA-II",
    "parameters": {
      "population_size": 100,
      "n_generations": 300,
      "seed": 42
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 15.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 30000,
      "convergence_tolerance": 1e-6,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "NSGA-II non-dominated sorting test benchmark"
  }
}
