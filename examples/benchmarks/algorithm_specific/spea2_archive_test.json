{
  "problem": {
    "name": "SPEA2 Archive Test - ZDT6",
    "description": "ZDT6-based problem optimized for SPEA2: Non-uniform search space with sparse Pareto optimal region. Tests SPEA2's archive mechanism and clustering. Expected: Good performance in difficult regions.",
    "type": "Custom Problem",
    "variables": [
    {
      "name": "x1",
      "type": "Real",
      "lower_bound": 0.0,
      "upper_bound": 1.0,
      "initial_value": 0.5
    },
    {
      "name": "x2",
      "type": "Real",
      "lower_bound": 0.0,
      "upper_bound": 1.0,
      "initial_value": 0.5
    },
    {
      "name": "x3",
      "type": "Real",
      "lower_bound": 0.0,
      "upper_bound": 1.0,
      "initial_value": 0.5
    }
  ],
  "objectives": [
    {
      "name": "f1_nonuniform",
      "direction": "Minimize",
      "weight": 1.0,
      "function": "1 - exp(-4 * x1) * sin(6 * 3.14159 * x1)**6",
      "description": "Non-uniform density objective"
    },
    {
      "name": "f2_sparse",
      "direction": "Minimize",
      "weight": 1.0,
      "function": "(1 + x2 + x3) * (1 - (1 - exp(-4 * x1) * sin(6 * 3.14159 * x1)**6) / (1 + x2 + x3))**2",
      "description": "Sparse Pareto optimal region"
    }
  ],
  "constraints": []
  },
  "algorithm": {
    "category": "Evolutionary Algorithms",
    "name": "SPEA2",
    "parameters": {
      "population_size": 50,
      "archive_size": 50,
      "n_generations": 200,
      "seed": 1
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 15.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 10000,
      "convergence_tolerance": 0.0,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI Algorithm-Specific Benchmark",
    "version": "1.0.0",
    "algorithm_optimized": "SPEA2",
    "problem_type": "Bi-objective with irregular front",
    "expected_performance": "Excellent - Good coverage of sparse/irregular Pareto regions"
  }
}
