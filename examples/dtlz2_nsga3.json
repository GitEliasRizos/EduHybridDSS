{
  "problem": {
    "name": "DTLZ2 Test Problem",
    "description": "Deb-Thiele-Laumanns-Zitzler function 2 is a scalable test problem for many-objective optimization. This version has 3 objectives and creates a spherical Pareto front.",
    "type": "Test Function",
    "variables": [
      {"name": "x1", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5},
      {"name": "x2", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5},
      {"name": "x3", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5},
      {"name": "x4", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5},
      {"name": "x5", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5},
      {"name": "x6", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5},
      {"name": "x7", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5},
      {"name": "x8", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5}
    ],
    "objectives": [
      {
        "name": "f1",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "(1 + (x3 + x4 + x5 + x6 + x7 + x8 - 0.5)**2) * cos(x1 * pi / 2) * cos(x2 * pi / 2)"
      },
      {
        "name": "f2",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "(1 + (x3 + x4 + x5 + x6 + x7 + x8 - 0.5)**2) * cos(x1 * pi / 2) * sin(x2 * pi / 2)"
      },
      {
        "name": "f3",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "(1 + (x3 + x4 + x5 + x6 + x7 + x8 - 0.5)**2) * sin(x1 * pi / 2)"
      }
    ],
    "constraints": []
  },
  "algorithm": {
    "category": "Reference Point-based",
    "name": "NSGA-III",
    "parameters": {
      "population_size": 92,
      "n_generations": 400,
      "seed": 42
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 1.0,
      "eta": 30.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.125,
      "eta": 20.0
    },
    "reference_directions": {
      "method": "Das-Dennis",
      "n_directions": 91,
      "n_partitions": 12,
      "scaling": 1.0
    },
    "termination": {
      "max_evaluations": 40000,
      "convergence_tolerance": 1e-6,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "DTLZ2 many-objective problem with NSGA-III configuration",
    "recommended_for": "Many-objective optimization, algorithm comparison",
    "reference": "Deb, K., Thiele, L., Laumanns, M., Zitzler, E. (2005). Scalable Test Problems for Evolutionary Multiobjective Optimization"
  }
}
