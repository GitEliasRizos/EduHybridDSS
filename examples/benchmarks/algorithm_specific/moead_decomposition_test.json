{
  "problem": {
    "name": "MOEA/D Decomposition Test - 3-Objective Problem",
    "description": "Well-structured 3-objective problem designed to test MOEA/D's decomposition approach. Uses weight vectors to guide search across different regions of Pareto front. Tests uniform weight distribution.",
    "type": "Decomposition Test Problem",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.33
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.33
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.33
      },
      {
        "name": "x4",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.33
      },
      {
        "name": "x5",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.33
      }
    ],
    "objectives": [
      {
        "name": "f1_sphere",
        "direction": "Minimize",
        "weight": 0.333,
        "function": "x1**2 + x2**2 + x3**2 + x4**2 + x5**2"
      },
      {
        "name": "f2_rosenbrock",
        "direction": "Minimize", 
        "weight": 0.333,
        "function": "(1 - x1)**2 + 100 * (x2 - x1**2)**2"
      },
      {
        "name": "f3_rastrigin",
        "direction": "Minimize",
        "weight": 0.334,
        "function": "10 * 3 + (x1**2 - 10 * cos(2 * 3.14159 * x1)) + (x2**2 - 10 * cos(2 * 3.14159 * x2)) + (x3**2 - 10 * cos(2 * 3.14159 * x3))"
      }
    ],
    "constraints": []
  },
  "algorithm": {
    "category": "Decomposition-based",
    "name": "MOEA/D",
    "parameters": {
      "population_size": 105,
      "n_generations": 400,
      "seed": 456,
      "decomposition": "PBI",
      "n_neighbors": 20
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 20.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.2,
      "eta": 15.0
    },
    "reference_directions": {
      "type": "Das-Dennis",
      "n_partitions": 12,
      "n_directions": 105,
      "scaling": 1.0
    },
    "termination": {
      "max_evaluations": 42000,
      "convergence_tolerance": 1e-4,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "MOEA/D decomposition approach test with 3-objective problem"
  }
}
