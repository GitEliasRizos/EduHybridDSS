{
  "problem": {
    "name": "MOEA/D 3-Objective Weight Vector Test",
    "description": "Classical DTLZ2-style 3-objective problem optimized for MOEA/D weight vector distribution testing. Tests uniform weight generation and neighbor-based mating strategy.",
    "type": "Weight Distribution Test",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      },
      {
        "name": "x4",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      },
      {
        "name": "x5",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      },
      {
        "name": "x6",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      }
    ],
    "objectives": [
      {
        "name": "f1_dtlz_style",
        "direction": "Minimize",
        "weight": 0.333,
        "function": "(1 + g) * cos(x1 * pi / 2) * cos(x2 * pi / 2)"
      },
      {
        "name": "f2_dtlz_style",
        "direction": "Minimize",
        "weight": 0.333,
        "function": "(1 + g) * cos(x1 * pi / 2) * sin(x2 * pi / 2)"
      },
      {
        "name": "f3_dtlz_style",
        "direction": "Minimize",
        "weight": 0.334,
        "function": "(1 + g) * sin(x1 * pi / 2)"
      }
    ],
    "constraints": [],
    "auxiliary_functions": {
      "g": "sum((xi - 0.5)^2 for xi in [x3, x4, x5, x6])"
    }
  },
  "algorithm": {
    "category": "Decomposition-based",
    "name": "MOEA/D",
    "parameters": {
      "population_size": 91,
      "n_neighbors": 15,
      "prob_neighbor_mating": 0.8,
      "n_generations": 350,
      "seed": 789,
      "decomposition": "Tchebycheff",
      "weight_generation": "uniform"
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 30.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 31850,
      "convergence_tolerance": 1e-5,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "MOEA/D 3-objective weight vector distribution test benchmark"
  }
}
