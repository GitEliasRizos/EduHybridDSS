{
  "problem": {
    "name": "NSGA-II Steady State Test - Bi-objective Optimization",
    "description": "Bi-objective problem optimized for NSGA-II's non-dominated sorting and crowding distance selection. Tests convergence behavior and diversity maintenance.",
    "type": "Hypervolume Test Problem",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": -2.0,
        "upper_bound": 2.0,
        "initial_value": 0.0
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": -2.0,
        "upper_bound": 2.0,
        "initial_value": 0.0
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": -2.0,
        "upper_bound": 2.0,
        "initial_value": 0.0
      }
    ],
    "objectives": [
      {
        "name": "f1_hypervolume",
        "direction": "Minimize",
        "weight": 0.5,
        "function": "x1**2 + x2**2 + x3**2 + 0.1 * sin(5 * x1) + 0.1 * sin(5 * x2)"
      },
      {
        "name": "f2_s_metric",
        "direction": "Minimize",
        "weight": 0.5,
        "function": "(x1 - 1)**2 + (x2 - 1)**2 + (x3 - 1)**2 + 0.05 * cos(8 * x3)"
      }
    ],
    "constraints": [
      {
        "name": "c1_circular_constraint",
        "type": "Inequality",
        "function": "x1**2 + x2**2 - 3.0",
        "operator": "<="
      }
    ]
  },
  "algorithm": {
    "category": "Pareto-based",
    "name": "NSGA-II",
    "parameters": {
      "population_size": 50,
      "n_generations": 1000,
      "seed": 987
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 15.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.333,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 50000,
      "convergence_tolerance": 1e-6,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "NSGA-II bi-objective convergence optimization test benchmark"
  }
}
