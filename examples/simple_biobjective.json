{
  "problem": {
    "name": "Simple Bi-objective Problem",
    "description": "A simple bi-objective optimization problem with two variables. Both objectives are quadratic functions that create a convex Pareto front. This problem is ideal for beginners to understand multi-objective optimization concepts.",
    "type": "Mathematical Function",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      }
    ],
    "objectives": [
      {
        "name": "f1",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "x1**2 + x2**2"
      },
      {
        "name": "f2",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "(x1 - 1)**2 + (x2 - 1)**2"
      }
    ],
    "constraints": []
  },
  "algorithm": {
    "category": "Evolutionary Algorithms",
    "name": "NSGA-II",
    "parameters": {
      "population_size": 100,
      "n_generations": 250,
      "seed": 42
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 15.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 25000,
      "convergence_tolerance": 1e-6,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "Complete optimization setup for simple bi-objective problem",
    "recommended_for": "Beginners, testing basic functionality"
  }
}
