{
  "name": "Gear Train Design - Discrete Manufacturing",
  "description": "Gear train design with discrete gear ratios and manufacturing constraints. Creates truly discrete Pareto front with limited optimal configurations. Expected: 2-8 solutions.",
  "variables": [
    {
      "name": "gear1_teeth",
      "type": "integer",
      "lower_bound": 12,
      "upper_bound": 60,
      "initial_value": 20,
      "description": "Number of teeth on gear 1"
    },
    {
      "name": "gear2_teeth",
      "type": "integer",
      "lower_bound": 12,
      "upper_bound": 60,
      "initial_value": 25,
      "description": "Number of teeth on gear 2"
    },
    {
      "name": "gear3_teeth",
      "type": "integer",
      "lower_bound": 12,
      "upper_bound": 60,
      "initial_value": 30,
      "description": "Number of teeth on gear 3"
    },
    {
      "name": "gear4_teeth",
      "type": "integer",
      "lower_bound": 12,
      "upper_bound": 60,
      "initial_value": 35,
      "description": "Number of teeth on gear 4"
    }
  ],
  "objectives": [
    {
      "name": "gear_ratio_error",
      "direction": "Minimize",
      "weight": 1.0,
      "function": "abs((gear1_teeth * gear3_teeth) / (gear2_teeth * gear4_teeth) - 6.931)",
      "description": "Error from target gear ratio of 6.931"
    },
    {
      "name": "total_cost",
      "direction": "Minimize", 
      "weight": 1.0,
      "function": "gear1_teeth + gear2_teeth + gear3_teeth + gear4_teeth + (gear1_teeth * gear2_teeth * 0.01) + (gear3_teeth * gear4_teeth * 0.01)",
      "description": "Total manufacturing cost"
    }
  ],
  "constraints": [
    {
      "name": "gear_ratio_feasible",
      "type": ">=",
      "function": "(gear1_teeth * gear3_teeth) / (gear2_teeth * gear4_teeth)",
      "value": 1.0,
      "description": "Minimum gear ratio"
    },
    {
      "name": "gear_ratio_max",
      "type": "<=", 
      "function": "(gear1_teeth * gear3_teeth) / (gear2_teeth * gear4_teeth)",
      "value": 20.0,
      "description": "Maximum gear ratio"
    },
    {
      "name": "size_compatibility_1",
      "type": ">=",
      "function": "gear2_teeth - gear1_teeth",
      "value": 4,
      "description": "Gear 2 must be larger than gear 1"
    },
    {
      "name": "size_compatibility_2",
      "type": ">=",
      "function": "gear4_teeth - gear3_teeth", 
      "value": 4,
      "description": "Gear 4 must be larger than gear 3"
    },
    {
      "name": "manufacturing_limit",
      "type": "<=",
      "function": "gear1_teeth + gear2_teeth + gear3_teeth + gear4_teeth",
      "value": 180,
      "description": "Total teeth manufacturing limit"
    }
  ]
}
