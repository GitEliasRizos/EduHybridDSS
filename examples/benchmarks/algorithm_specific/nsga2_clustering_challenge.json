{
  "problem": {
    "name": "NSGA-II Clustering Challenge - Deceptive Multimodal",
    "description": "Complex multimodal problem with multiple local Pareto fronts and clustering challenges. Tests NSGA-II's non-dominated sorting and crowding distance. Features deceptive objective space.",
    "type": "Multimodal Test Problem",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": -5.0,
        "upper_bound": 5.0,
        "initial_value": 0.0
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": -5.0,
        "upper_bound": 5.0,
        "initial_value": 0.0
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": -5.0,
        "upper_bound": 5.0,
        "initial_value": 0.0
      },
      {
        "name": "x4",
        "type": "Real",
        "lower_bound": -5.0,
        "upper_bound": 5.0,
        "initial_value": 0.0
      }
    ],
    "objectives": [
      {
        "name": "f1_multimodal",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "1 * x1**4 - 16 * x1**2 + 5 * x1 + 2 * x2**4 - 16 * x2**2 + 5 * x2 + 3 * x3**4 - 16 * x3**2 + 5 * x3 + 4 * x4**4 - 16 * x4**2 + 5 * x4 + 100"
      },
      {
        "name": "f2_clustering",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "x1**2 + sin(5 * 3.14159 * x1) + x2**2 + sin(5 * 3.14159 * x2) + x3**2 + sin(5 * 3.14159 * x3) + x4**2 + sin(5 * 3.14159 * x4) + 50"
      }
    ],
    "constraints": [
      {
        "name": "c1_boundary",
        "type": "Inequality",
        "function": "x1**2 + x2**2 - 16",
        "operator": "<="
      },
      {
        "name": "c2_nonlinear",
        "type": "Inequality",
        "function": "x3**2 + x4**2 - 9",
        "operator": "<="
      }
    ]
  },
  "algorithm": {
    "category": "Pareto-based",
    "name": "NSGA-II",
    "parameters": {
      "population_size": 120,
      "n_generations": 500,
      "seed": 123
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.95,
      "eta": 20.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.15,
      "eta": 25.0
    },
    "termination": {
      "max_evaluations": 60000,
      "convergence_tolerance": 1e-5,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "NSGA-II clustering and fitness assignment challenge benchmark"
  }
}
