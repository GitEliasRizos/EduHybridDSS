{
  "problem": {
    "name": "Fonseca-Fleming - Concave with Constraints",
    "description": "Fonseca-Fleming function with additional constraints. Classic concave bi-objective problem. Expected: 30-80 solutions on concave curve.",
    "type": "Test Function",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": -4.0,
        "upper_bound": 4.0,
        "initial_value": 0.0
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": -4.0,
        "upper_bound": 4.0,
        "initial_value": 0.0
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": -4.0,
        "upper_bound": 4.0,
        "initial_value": 0.0
      }
    ],
    "objectives": [
      {
        "name": "f1",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "1 - exp(-((x1 - 1/sqrt(3))**2 + (x2 - 1/sqrt(3))**2 + (x3 - 1/sqrt(3))**2))"
      },
      {
        "name": "f2",
        "direction": "Minimize", 
        "weight": 1.0,
        "function": "1 - exp(-((x1 + 1/sqrt(3))**2 + (x2 + 1/sqrt(3))**2 + (x3 + 1/sqrt(3))**2))"
      }
    ],
    "constraints": [
      {
        "name": "sphere_constraint",
        "type": "<=",
        "function": "x1**2 + x2**2 + x3**2",
        "value": 9.0
      }
    ]
  },
  "algorithm": {
    "category": "Pareto-based",
    "name": "NSGA-II",
    "parameters": {
      "population_size": 100,
      "n_generations": 200,
      "seed": 42
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 15.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 20000,
      "convergence_tolerance": 1e-6,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "Fonseca-Fleming benchmark - constrained concave front test"
  }
}
