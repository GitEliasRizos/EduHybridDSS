{
  "problem": {
    "name": "Constrained Engineering Design",
    "description": "Engineering design optimization with realistic constraints and multiple solutions",
    "type": "Engineering Problem",
    "variables": [
      {
        "name": "diameter",
        "type": "Real",
        "lower_bound": 1.0,
        "upper_bound": 20.0,
        "initial_value": 5.0
      },
      {
        "name": "thickness",
        "type": "Real",
        "lower_bound": 0.1,
        "upper_bound": 3.0,
        "initial_value": 1.0
      },
      {
        "name": "length",
        "type": "Real",
        "lower_bound": 5.0,
        "upper_bound": 50.0,
        "initial_value": 20.0
      },
      {
        "name": "material_strength",
        "type": "Real",
        "lower_bound": 1.0,
        "upper_bound": 5.0,
        "initial_value": 2.0
      }
    ],
    "objectives": [
      {
        "name": "weight",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "diameter * thickness * length * material_strength * 0.01"
      },
      {
        "name": "cost",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "diameter * diameter + thickness * 100 + length * 5 + material_strength * 200"
      }
    ],
    "constraints": [
      {
        "name": "strength_requirement",
        "type": ">=",
        "function": "thickness * material_strength",
        "value": 0.5
      },
      {
        "name": "size_limitation",
        "type": "<=",
        "function": "diameter + length",
        "value": 60.0
      }
    ]
  },
  "algorithm": {
    "category": "Pareto-based",
    "name": "NSGA-II",
    "parameters": {
      "population_size": 100,
      "n_generations": 200,
      "seed": 42
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 15.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 20000,
      "convergence_tolerance": 1e-6,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "Simple constrained engineering problem with guaranteed multiple solutions",
    "recommended_for": "Engineering design optimization"
  }
}
