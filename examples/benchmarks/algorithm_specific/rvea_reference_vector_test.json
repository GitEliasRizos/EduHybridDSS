{
  "problem": {
    "name": "RVEA Reference Vector Test - DTLZ1 Style",
    "description": "Standard DTLZ1-based 4-objective problem for testing RVEA's reference vector guided search. Uses simple, well-behaved objective functions.",
    "type": "Reference Vector Test",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.25
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.25
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.25
      },
      {
        "name": "x4",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      },
      {
        "name": "x5",
        "type": "Real",
        "lower_bound": 0.0,
        "upper_bound": 1.0,
        "initial_value": 0.5
      }
    ],
    "objectives": [
      {
        "name": "f1_dtlz",
        "direction": "Minimize",
        "weight": 0.25,
        "function": "0.5 * x1 * x2 * x3 * (1 + (x4 - 0.5)^2 + (x5 - 0.5)^2)"
      },
      {
        "name": "f2_dtlz",
        "direction": "Minimize",
        "weight": 0.25,
        "function": "0.5 * x1 * x2 * (1 - x3) * (1 + (x4 - 0.5)^2 + (x5 - 0.5)^2)"
      },
      {
        "name": "f3_dtlz",
        "direction": "Minimize",
        "weight": 0.25,
        "function": "0.5 * x1 * (1 - x2) * (1 + (x4 - 0.5)^2 + (x5 - 0.5)^2)"
      },
      {
        "name": "f4_dtlz",
        "direction": "Minimize",
        "weight": 0.25,
        "function": "0.5 * (1 - x1) * (1 + (x4 - 0.5)^2 + (x5 - 0.5)^2)"
      }
    ],
    "constraints": []
  },
  "algorithm": {
    "category": "Reference Point-based",
    "name": "RVEA",
    "parameters": {
      "population_size": 4,
      "n_generations": 100,
      "seed": 321,
      "alpha": 2.0,
      "adaptation_frequency": 0.1
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 30.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 400,
      "convergence_tolerance": 1e-4,
      "enable_convergence": true,
      "verbose": true
    },
    "reference_directions": {
      "type": "Das-Dennis",
      "n_dim": 4,
      "n_partitions": 1
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "RVEA reference vector guided search test with 4-objective multimodal problem"
  }
}
