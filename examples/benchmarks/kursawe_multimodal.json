{
  "problem": {
    "name": "Kursawe Function - Multi-modal",
    "description": "Kursawe function with multiple local fronts. Tests algorithm's ability to maintain diversity across multiple optimal regions. Expected: 15-40 solutions in disconnected regions.",
    "type": "Test Function",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": -5.0,
        "upper_bound": 5.0,
        "initial_value": 0.0
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": -5.0,
        "upper_bound": 5.0,
        "initial_value": 0.0
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": -5.0,
        "upper_bound": 5.0,
        "initial_value": 0.0
      }
    ],
    "objectives": [
      {
        "name": "f1",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "-10 * exp(-0.2 * sqrt(x1**2 + x2**2)) - 10 * exp(-0.2 * sqrt(x2**2 + x3**2))"
      },
      {
        "name": "f2",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "abs(x1)**0.8 + 5 * sin(x1**3) + abs(x2)**0.8 + 5 * sin(x2**3) + abs(x3)**0.8 + 5 * sin(x3**3)"
      }
    ],
    "constraints": []
  },
  "algorithm": {
    "category": "Archive-based",
    "name": "SPEA2",
    "parameters": {
      "population_size": 100,
      "archive_size": 100,
      "n_generations": 300,
      "seed": 42
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 15.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 30000,
      "convergence_tolerance": 1e-6,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "Kursawe benchmark - multi-modal disconnected fronts test"
  }
}
