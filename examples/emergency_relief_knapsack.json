      "n_directions": 91,
      "n_partitions": 12,
      "scaling": 1.0
    },
    "termination": {
      "max_evaluations": 25000,
      "convergence_tolerance": 1e-6,
      "enable_convergence": false,
      "verbose": true
    }
  },
