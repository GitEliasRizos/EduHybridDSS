{
  "problem": {
    "name": "IBEA Hypervolume Indicator Test - Convergence Challenge",
    "description": "Multi-objective problem designed to test IBEA's indicator-based selection with hypervolume indicator. Features challenging convergence characteristics and diverse Pareto front shapes.",
    "type": "Indicator-based Test",
    "variables": [
      {
        "name": "x1",
        "type": "Real",
        "lower_bound": -1.0,
        "upper_bound": 1.0,
        "initial_value": 0.0
      },
      {
        "name": "x2",
        "type": "Real",
        "lower_bound": -1.0,
        "upper_bound": 1.0,
        "initial_value": 0.0
      },
      {
        "name": "x3",
        "type": "Real",
        "lower_bound": -1.0,
        "upper_bound": 1.0,
        "initial_value": 0.0
      },
      {
        "name": "x4",
        "type": "Real",
        "lower_bound": -1.0,
        "upper_bound": 1.0,
        "initial_value": 0.0
      }
    ],
    "objectives": [
      {
        "name": "f1_indicator",
        "direction": "Minimize",
        "weight": 0.5,
        "function": "sum(xi^2 for xi in [x1, x2]) + 0.2 * sum(sin(10 * xi) for xi in [x3, x4])"
      },
      {
        "name": "f2_hypervolume_challenge",
        "direction": "Minimize",
        "weight": 0.5,
        "function": "sum((xi + 0.5)^2 for xi in [x1, x2]) + 0.1 * sum(cos(12 * xi) for xi in [x3, x4])"
      }
    ],
    "constraints": [
      {
        "name": "c1_sum_constraint",
        "type": "Inequality",
        "function": "x1 + x2 + x3 + x4 - 1.5",
        "operator": "<="
      },
      {
        "name": "c2_difference_constraint",
        "type": "Inequality",
        "function": "x1 - x2 + x3 - x4 + 0.8",
        "operator": ">="
      }
    ]
  },
  "algorithm": {
    "category": "Indicator-based",
    "name": "IBEA",
    "parameters": {
      "population_size": 100,
      "n_generations": 400,
      "seed": 147,
      "indicator": "hv",
      "kappa": 0.05
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 20.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.25,
      "eta": 15.0
    },
    "termination": {
      "max_evaluations": 40000,
      "convergence_tolerance": 1e-5,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "IBEA hypervolume indicator-based selection test benchmark"
  }
}
