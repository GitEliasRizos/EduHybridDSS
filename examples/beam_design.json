{
  "problem": {
    "name": "Steel Beam Design Optimization",
    "description": "Classic structural engineering problem with clear cost-performance trade-offs",
    "type": "Engineering Problem",
    "variables": [
      {
        "name": "height",
        "type": "Real",
        "lower_bound": 10.0,
        "upper_bound": 80.0,
        "initial_value": 30.0
      },
      {
        "name": "width",
        "type": "Real",
        "lower_bound": 5.0,
        "upper_bound": 50.0,
        "initial_value": 20.0
      },
      {
        "name": "thickness",
        "type": "Real",
        "lower_bound": 1.0,
        "upper_bound": 10.0,
        "initial_value": 3.0
      }
    ],
    "objectives": [
      {
        "name": "weight_cost",
        "direction": "Minimize",
        "weight": 1.0,
        "function": "(height * width * thickness) * 0.001"
      },
      {
        "name": "deflection",
        "direction": "Minimize", 
        "weight": 1.0,
        "function": "1000000.0 / (width * thickness * height**3)"
      }
    ],
    "constraints": [
      {
        "name": "stress_limit",
        "type": "<=",
        "function": "6000000.0 / (width * thickness * height)",
        "value": 250.0
      },
      {
        "name": "slenderness",
        "type": "<=",
        "function": "height / thickness",
        "value": 50.0
      }
    ]
  },
  "algorithm": {
    "category": "Pareto-based",
    "name": "NSGA-II",
    "parameters": {
      "population_size": 100,
      "n_generations": 200,
      "seed": 42
    },
    "crossover": {
      "operator": "SBX (Simulated Binary Crossover)",
      "probability": 0.9,
      "eta": 15.0
    },
    "mutation": {
      "operator": "Polynomial Mutation",
      "probability": 0.1,
      "eta": 20.0
    },
    "termination": {
      "max_evaluations": 20000,
      "convergence_tolerance": 1e-6,
      "enable_convergence": true,
      "verbose": true
    }
  },
  "metadata": {
    "created_by": "PyMOO GUI",
    "version": "1.0.0",
    "description": "Classic beam design with realistic Pareto front",
    "recommended_for": "Structural engineering optimization"
  }
}
