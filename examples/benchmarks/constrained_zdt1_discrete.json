{
  "name": "Constrained ZDT1 - Discrete Solutions",
  "description": "Modified ZDT1 with constraints to create discrete Pareto front. Tests constrained optimization with reduced solution set. Expected: 5-15 solutions only.",
  "variables": [
    {
      "name": "x1",
      "type": "Real",
      "lower_bound": 0.0,
      "upper_bound": 1.0,
      "initial_value": 0.5
    },
    {
      "name": "x2",
      "type": "Real",
      "lower_bound": 0.0,
      "upper_bound": 1.0,
      "initial_value": 0.5
    },
    {
      "name": "x3",
      "type": "Real",
      "lower_bound": 0.0,
      "upper_bound": 1.0,
      "initial_value": 0.5
    }
  ],
  "objectives": [
    {
      "name": "f1",
      "direction": "Minimize",
      "weight": 1.0,
      "function": "x1",
      "description": "First objective - ZDT1 style"
    },
    {
      "name": "f2",
      "direction": "Minimize",
      "weight": 1.0,
      "function": "(1 + x2 + x3) * (1 - (x1 / (1 + x2 + x3))**0.5)",
      "description": "Second objective - ZDT1 style"
    }
  ],
  "constraints": [
    {
      "name": "discrete_constraint_1",
      "type": "<=",
      "function": "x1**2 + x2**2",
      "value": 0.5,
      "description": "Circular constraint eliminating many solutions"
    },
    {
      "name": "discrete_constraint_2", 
      "type": ">=",
      "function": "x1 + x2 + x3",
      "value": 0.8,
      "description": "Sum constraint"
    },
    {
      "name": "discrete_constraint_3",
      "type": "<=",
      "function": "abs(x1 - 0.3) + abs(x2 - 0.3)",
      "value": 0.4,
      "description": "Manhattan distance constraint"
    }
  ]
}
