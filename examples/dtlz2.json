{
  "name": "DTLZ2 Test Problem",
  "description": "Deb-Thiele-Laumanns-Zitzler function 2 is a scalable test problem for many-objective optimization. This simplified version has 3 objectives and 5 variables.",
  "type": "Test Function",
  "variables": [
    {"name": "x1", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5},
    {"name": "x2", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5},
    {"name": "x3", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5},
    {"name": "x4", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5},
    {"name": "x5", "type": "Real", "lower_bound": 0.0, "upper_bound": 1.0, "initial_value": 0.5}
  ],
  "objectives": [
    {
      "name": "f1",
      "direction": "Minimize",
      "weight": 1.0,
      "function": "(1 + (x3 - 0.5)**2 + (x4 - 0.5)**2 + (x5 - 0.5)**2) * cos(x1 * pi / 2) * cos(x2 * pi / 2)"
    },
    {
      "name": "f2",
      "direction": "Minimize",
      "weight": 1.0,
      "function": "(1 + (x3 - 0.5)**2 + (x4 - 0.5)**2 + (x5 - 0.5)**2) * cos(x1 * pi / 2) * sin(x2 * pi / 2)"
    },
    {
      "name": "f3",
      "direction": "Minimize",
      "weight": 1.0,
      "function": "(1 + (x3 - 0.5)**2 + (x4 - 0.5)**2 + (x5 - 0.5)**2) * sin(x1 * pi / 2)"
    }
  ],
  "constraints": []
}
